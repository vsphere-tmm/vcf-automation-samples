<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>rest-api-parent</artifactId>
  <packaging>pom</packaging>
  <parent>
    <groupId>com.vmware.vcloud</groupId>
    <artifactId>cloud-director-2</artifactId>
    <version>1.0.0</version>
    <relativePath>../../../../../cloud-parent/pom.xml</relativePath>
  </parent>
  <name>${project.artifactId} - RESTful vCloud API</name>
  <description>Master Maven project builder for the RESTful API</description>
  <modules>
    <module>rest-api-commons</module>
    <module>rest-api-xjc-plugin</module>
    <module>rest-api-schemas</module>
    <module>jax-rs-activator</module>
    <module>rest-api-handlers</module>
    <module>rest-api-toolkit</module>
    <module>rest-api-client</module>
    <module>openapi-schemas</module>
    <module>openapi-appliance</module>
    <module>oauth-api-bindings</module>
    <module>openapi-jaxrs-stubs</module>
    <module>../../utilities/querysvcgen</module>
  </modules>
  <dependencies>
    <dependency>
      <groupId>org.easymock</groupId>
      <artifactId>easymock</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.easymock</groupId>
      <artifactId>easymockclassextension</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit-dep</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>includeRT</id>
      <activation>
        <!-- This is effectively an "always on" condition. This profile can only be
                   explicitly disabled at the command line with the flag -P!includeRT -->
        <jdk>[0,)</jdk>
      </activation>
      <modules>
        <module>../../utilities/rest-api-docgenerator</module>
        <module>../../utilities/rest-api-examples</module>
      </modules>
    </profile>
    <profile>
      <id>publishDeliverables</id>
      <activation>
        <property>
          <name>env.PUBLISH_DIR</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>publishSchemaArchives</id>
                <phase>install</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${env.PUBLISH_DIR}/com/vmware/vcloud/${project.artifactId}/${project.version}</outputDirectory>
                  <resources>
                      <resource>
                          <directory>/${settings.localRepository}/com/vmware/vcloud/${project.artifactId}/${project.version}</directory>
                          <includes>
                              <include>${project.build.finalName}*jar</include>
                              <include>*pom</include>
                          </includes>
                          <excludes>
                              <exclude>*test*</exclude>
                          </excludes>
                      </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <configuration/>
          <executions>
            <execution>
              <id>test-jar</id>
              <phase>package</phase>
              <configuration/>
              <goals>
                <goal>test-jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
