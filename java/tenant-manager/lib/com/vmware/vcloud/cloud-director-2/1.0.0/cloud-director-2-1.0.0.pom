              <version>${servicemix.jcip-annotations.version}</version>
            </dependency>
            <dependency>
              <groupId>net.minidev</groupId>
              <artifactId>json-smart</artifactId>
              <version>${minidev.json-smart.version}</version>
            </dependency>
            <dependency>
              <groupId>com.vmware.vchs.iam</groupId>
              <artifactId>iam-schemas</artifactId>
              <version>${vchs.iam.schemas.version}</version>
            </dependency>
            <dependency>
              <groupId>org.mockito</groupId>
              <artifactId>mockito-core</artifactId>
              <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-inline</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bradneighbors.buildable</groupId>
                <artifactId>buildable</artifactId>
                <version>${buildable.version}</version>
            </dependency>
            <!-- Commons VFS2 -->
            <dependency>
              <groupId>org.apache.commons</groupId>
              <artifactId>commons-vfs2</artifactId>
              <version>${commons-vfs2.version}</version>
            </dependency>
	    <dependency>
              <groupId>com.sshtools</groupId>
              <artifactId>vfs-s3</artifactId>
              <version>${sshtools.vfs-s3.version}</version>
	    </dependency>
            <dependency>
              <groupId>com.amazonaws</groupId>
              <artifactId>aws-java-sdk-sts</artifactId>
              <version>${aws-java-sdk.version}</version>
              <exclusions>
                 <exclusion>
                   <groupId>commons-logging</groupId>
                   <artifactId>commons-logging</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>commons-httpclient</groupId>
                   <artifactId>commons-httpclient</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>org.apache.httpcomponents</groupId>
                   <artifactId>httpclient</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>org.apache.httpcomponents.client5</groupId>
                   <artifactId>httpclient5</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.core</groupId>
                   <artifactId>jackson-core</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.core</groupId>
                   <artifactId>jackson-databind</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.core</groupId>
                   <artifactId>jackson-annotations</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.dataformat</groupId>
                   <artifactId>jackson-dataformat-yaml</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.dataformat</groupId>
                   <artifactId>jackson-dataformat-cbor</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>joda-time</groupId>
                   <artifactId>joda-time</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.amazonaws</groupId>
                   <artifactId>aws-java-sdk-s3</artifactId>
                 </exclusion>
             </exclusions>
          </dependency>
          <dependency>
              <groupId>com.amazonaws</groupId>
              <artifactId>aws-java-sdk-s3</artifactId>
              <version>${aws-java-sdk.version}</version>
              <exclusions>
                 <exclusion>
                   <groupId>commons-logging</groupId>
                   <artifactId>commons-logging</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>commons-httpclient</groupId>
                   <artifactId>commons-httpclient</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>org.apache.httpcomponents</groupId>
                   <artifactId>httpclient</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>org.apache.httpcomponents.client5</groupId>
                   <artifactId>httpclient5</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.core</groupId>
                   <artifactId>jackson-core</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.core</groupId>
                   <artifactId>jackson-databind</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.core</groupId>
                   <artifactId>jackson-annotations</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.dataformat</groupId>
                   <artifactId>jackson-dataformat-yaml</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.fasterxml.jackson.dataformat</groupId>
                   <artifactId>jackson-dataformat-cbor</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>joda-time</groupId>
                   <artifactId>joda-time</artifactId>
                 </exclusion>
                 <exclusion>
                   <groupId>com.amazonaws</groupId>
                   <artifactId>aws-java-sdk-s3</artifactId>
                 </exclusion>
             </exclusions>
           </dependency>
           <dependency>
	       <groupId>org.apache.kerby</groupId>
               <artifactId>kerb-client-api-all</artifactId>
	       <version>${org.apache.kerby.version}</version>
          </dependency>
          <dependency>
               <groupId>cz.jirutka.rsql</groupId>
               <artifactId>rsql-parser</artifactId>
               <version>${cz.jirutka.rsql.version}</version>
          </dependency>
          <dependency>
              <groupId>com.amazonaws</groupId>
              <artifactId>aws-java-sdk-lambda</artifactId>
              <version>${aws-java-sdk.version}</version>
          </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>

        <!--
            Release build profile

            This profile configures maven to work under gobuild.
        -->
        <profile>
            <id>release</id>

            <activation>
                <property>
                    <name>env.BUILD_NUMBER</name>
                </property>
            </activation>

            <properties>
                <gobuild.BUILD_NUMBER>${env.BUILD_NUMBER}</gobuild.BUILD_NUMBER>
                <vcloud.version>1.0.0.${env.BUILD_NUMBER}</vcloud.version>
                <vcloudVersion>1.0.0.${env.BUILD_NUMBER}</vcloudVersion>
                <annotations.isOfficialKey>${env.JARSIGN_OFFICIAL_KEY}</annotations.isOfficialKey>
                <annotations.keyId>${env.ANNOTATIONS_KEYID}</annotations.keyId>
            </properties>

        </profile>

        <!--
            Default build profile

            This profile configures maven to work
            under the VMware official build system.
        -->
        <profile>
            <id>default-build</id>

            <activation>
                <property>
                    <name>!env.BUILD_NUMBER</name>
                </property>
            </activation>

            <properties>
                <gobuild.BUILD_NUMBER>0000</gobuild.BUILD_NUMBER>
                <vcloud.version>0.0.1.0000</vcloud.version>
                <vcloudVersion>0.0.1.0000</vcloudVersion>
            </properties>
        </profile>

        <!-- Defines a product.version property for typical developer builds. -->
        <profile>
            <id>no-makefile</id>

            <activation>
                <property>
                    <name>!env.VERSION</name>
                </property>
            </activation>

            <properties>
                <product.version>10.7.0.${gobuild.BUILD_NUMBER}</product.version>
            </properties>
        </profile>

        <!-- Defines the product.version property to be whatever defs.mk exported to the environment. -->
        <profile>
            <id>makefile</id>

            <activation>
                <property>
                    <name>env.VERSION</name>
                </property>
            </activation>

            <properties>
                <product.version>${env.VERSION}.${gobuild.BUILD_NUMBER}</product.version>
                <vcloud.test.report.dir>${env.BUILDLOG_DIR}/test-logs/${project.artifactId}</vcloud.test.report.dir>
            </properties>
        </profile>

        <profile>
            <id>buildPhoneHome</id>
            <!-- Ensure that PhoneHome build is always done -->
            <activation>
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../lib/vcloud-phonehome/app</module>
            </modules>
        </profile>

        <profile>
            <id>buildDependencies</id>
            <activation>
                <!-- This is effectively an "always on" condition. This profile can only be
                     explicitly disabled at the command line with the flag -P!buildDependencies -->
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../lib/gobuild/cloud_director</module>
                <module>../lib/osgi-wrappers</module>
                <module>../lib/upgrade-framework</module>
                <module>../lib/activity-framework</module>
            </modules>
        </profile>
        <profile>
            <id>buildRestApiDependencies</id>
            <activation>
                <!-- This is disabled by default since it must _only_ be activated when
                     building cloud_director_rest_api gobuild target. When building main
                     product above 'buildDependencies' profile is a super set and will
                     cover all steps this profile would -->
                <activeByDefault>false</activeByDefault>
            </activation>
            <modules>
                <module>../lib/gobuild/cloud_director_rest_api</module>
            </modules>
        </profile>
        <profile>
            <id>devIntegration</id>
            <activation>
                <!-- This is effectively an "always on" condition. This profile can only be
                     explicitly disabled at the command line with the flag -P!devIntegration -->
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../dev-integration/json-api-xjc-plugin</module>
            </modules>
        </profile>
        <profile>
            <id>coreProduct</id>
            <activation>
                <!-- This is effectively an "always on" condition. This profile can only be
                     explicitly disabled at the command line with the flag -P!coreProduct -->
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../cell/common/common-validation</module>
                <module>../cell</module>
                <module>../cell/vcloud-osgi-container</module>
                <module>../utilities/client-toolkit</module>
                <module>../utilities/cloud-director-solutions</module>
                <module>../utilities/post-install-config</module>
                <module>../utilities/cell-management-tool</module>
                <module>../utilities/cell-management-tool-vcd-client</module>
                <module>../build/rpm</module>
                <module>../server/vlsi</module>
            </modules>
        </profile>
        <profile>
            <id>devAddons</id>
            <activation>
                <!-- This is effectively an "always on" condition. This profile can only be
                     explicitly disabled at the command line with the flag -P!devAddons -->
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../utilities/cell-management-tool-extensions</module>
                <module>../utilities/cell-management-tool-extensions-vcd-client</module>
                <module>../utilities/cell-management-tool-vcresiliency</module>
                <module>../utilities/cell-tests</module>
                <module>../utilities/vcloud-vcd-bindings</module>
                <module>../utilities/rest-api-typescript-bindings</module>
                <module>../utilities/workflow-debugging-tool</module>
            </modules>
        </profile>
        <profile>
            <id>includeUI</id>
            <activation>
                <!-- This is effectively an "always on" condition. This profile can only be
                     explicitly disabled at the command line with the flag -P!includeUI -->
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../ui</module>
            </modules>
        </profile>
        <profile>
            <id>includeST</id>
            <activation>
                <!-- This is effectively an "always on" condition. This profile can only be
                     explicitly disabled at the command line with the flag -P!includeST -->
                <jdk>[0,)</jdk>
            </activation>
            <modules>
                <module>../dev-integration/system-tests</module>
            </modules>
        </profile>

        <profile>
            <id>sca-scan</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
                <timestamp>${maven.build.timestamp}</timestamp>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.hpe.security.fortify.maven.plugin</groupId>
                        <artifactId>sca-maven-plugin</artifactId>
                        <version>17.20</version>
                        <configuration>
                            <environmentVariables>
                                <SCA_VM_OPTS> -Dfortify.sca.toplevel.artifactId=cloud-director-2 </SCA_VM_OPTS>
                            </environmentVariables>

                            <!-- binaries and output file settings -->
                            <resultsFile>vcd-scan-${gobuild.BUILD_NUMBER}-${maven.build.timestamp}.fpr</resultsFile>
                            <fortifyclient>/build/toolchain/lin64/fortify-ssc-latest/bin/fortifyclient</fortifyclient>
                            <sourceanalyzer>/build/toolchain/lin64/fortify-ssc-latest/bin/sourceanalyzer</sourceanalyzer>

                            <!--  Project settings -->
                            <buildId>FortifyBuild</buildId>
                            <buildLabel>cloud-director-2-1.0.0</buildLabel>
                            <buildProject>cloud-director-2</buildProject>
                            <buildVersion>1.0.0</buildVersion>
                            <incremental>false</incremental>
                            <incrementalBase>false</incrementalBase>

                            <!--  Project settings -->
                            <buildId>FortifyBuild</buildId>
                            <buildLabel>cloud-director-2-1.0.0</buildLabel>
                            <buildProject>cloud-director-2</buildProject>
                            <buildVersion>1.0.0</buildVersion>


                            <!-- Basic SCA Settings -->
                            <jre64>true</jre64>
                            <aggregate>true</aggregate>
                            <findbugs>false</findbugs>
                            <skipTests>true</skipTests>
                            <numOfWorkerThreads>8</numOfWorkerThreads>


                            <!-- Errors and logging -->
                            <debug>true</debug>
                            <verbose>true</verbose>
                            <scaFailOnError>true</scaFailOnError>
                            <scaTranslateFailOnError>true</scaTranslateFailOnError>
                            <scaScanFailOnError>true</scaScanFailOnError>
                            <scaUploadFailOnError>true</scaUploadFailOnError>
                            <scaDownloadFailOnError>true</scaDownloadFailOnError>

                            <!--  Exclusions and Rules filters  -->
                            <quickScan>false</quickScan>
                            <excludes>
                                <exclude>${SRCROOT}/utilities/post-install-config/src/main/resources/db/**/*</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>install-parent-poms</id>
            <activation>
                <file>
                    <exists>m2e-lifecycle-settings-pom.xml</exists>
                </file>
           </activation>
           <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-install-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>m2e-lifecycle-settings-pom.xml</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-file</goal>
                                </goals>
                                <configuration>
                                    <file>m2e-lifecycle-settings-pom.xml</file>
                                    <groupId>com.vmware.vcloud</groupId>
                                    <artifactId>m2e-lifecycle-settings</artifactId>
                                    <version>1.0.0</version>
                                    <packaging>pom</packaging>
                                </configuration>
                            </execution>
                            <execution>
                                <id>dependency-management-section-pom.xml</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-file</goal>
                                </goals>
                                <configuration>
                                    <file>dependency-management-section-pom.xml</file>
                                    <groupId>com.vmware.vcloud</groupId>
                                    <artifactId>dependency-management-section</artifactId>
                                    <version>1.0.0</version>
                                    <packaging>pom</packaging>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
           </build>
       </profile>

       <profile>
            <id>vcloud-stf-oidc-server</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
                <timestamp>${maven.build.timestamp}</timestamp>
            </properties>
            <modules>
                <module>../dev-integration/system-tests/vcloud-stf-oidc-server</module>
            </modules>
       </profile>
    </profiles>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>2.4.3</version>
                <configuration>
                    <aggregate>true</aggregate>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>2.1</version>
                <configuration>
                    <aggregate>true</aggregate>
                    <linkJavadoc>true</linkJavadoc>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>2.8</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>2.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>2.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <targetJdk>1.6</targetJdk>
                    <rulesets>
                        <ruleset>/rulesets/basic.xml</ruleset>
                        <ruleset>/rulesets/controversial.xml</ruleset>
                    </rulesets>
                    <format>xml</format>
                    <linkXref>true</linkXref>
                    <sourceEncoding>utf-8</sourceEncoding>
                    <minimumTokens>100</minimumTokens>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>taglist-maven-plugin</artifactId>
                <version>2.2</version>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>findbugs-maven-plugin</artifactId>
                <version>1.0-beta-1</version>
                <configuration>
                    <threshold>Low</threshold>
                    <effort>Default</effort>
                    <xmlOutput>true</xmlOutput>
                    <onlyAnalyze>com.vmware.vcloud.*,com.vmware.ssdc.*,com.vmware.consoleproxy.*</onlyAnalyze>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>cobertura-maven-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <instrumentation>
                        <excludes>
                            <exclude>**/*Test.class</exclude>
                            <exclude>**/vim40/*.class</exclude>
                        </excludes>
                    </instrumentation>
                    <formats>
                        <format>xml</format>
                    </formats>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jdepend-maven-plugin</artifactId>
                <version>2.0-beta-2</version>
            </plugin>

        </plugins>
    </reporting>
</project>
