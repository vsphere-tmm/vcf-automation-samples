    <packaging>pom</packaging>

    <name>cloud-director-2 - Cloud Director</name>

    <inceptionYear>2008</inceptionYear>
    <issueManagement>
        <system>Bugzilla</system>
        <url>http://bugzilla.eng.vmware.com/bugzilla/</url>
    </issueManagement>
