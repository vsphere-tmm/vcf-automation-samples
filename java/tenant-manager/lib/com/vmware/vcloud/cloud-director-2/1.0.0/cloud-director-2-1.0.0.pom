                    </exclusion>
                    <!--
                    we do not need this - see https://issues.apache.org/jira/browse/ARTEMIS-4710 ;
                    added explicit exclusion here just in case; this library poses a security risk
                    as it is tampering with the java security provider list
                    Artemis needlessly depends on it at runtime when SSL is enabled on an acceptor
                    for now we have mocked the class de.dentrassi.crypto.pem.PemKeyStoreProvider
                    -->
                    <exclusion>
                        <groupId>de.dentrassi.crypto</groupId>
                        <artifactId>pem-keystore</artifactId>
