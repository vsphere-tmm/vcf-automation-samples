    <organization>
        <name>VMware, Inc.</name>
        <url>http://www.vmware.com/</url>
    </organization>
    <url>https://wiki.eng.vmware.com/vCloud</url>

    <!--
        There are no top-level modules. All modules are distributed in various profiles to allow
        controlling additional behaviors (e.g. inclusion in static code analysis, part of core
        product build, etc).

        To add your new module, please add to appropriate <module> element in one of the profiles.
    -->

    <!--    <modules></modules>    -->

    <properties>
	<maven.compiler.source>11</maven.compiler.source>
	<maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <!-- GoBuild integration properties -->
        <OBJDIR>beta</OBJDIR>
        <RELTYPE>beta</RELTYPE>

        <!-- SRCROOT will be calculated if necessary by gmaven-plugin -->
        <BUILDROOT>${SRCROOT}/build</BUILDROOT>
        <PUBLISH_DIR>${BUILDROOT}/publish</PUBLISH_DIR>
        <GOBUILD_COMPUBLISH_DIR>${BUILDROOT}/gobuild/compublish</GOBUILD_COMPUBLISH_DIR>
        <!-- This should get over-ridden if an OB/SB -->
        <GOBUILD_AUTO_COMPONENTS>true</GOBUILD_AUTO_COMPONENTS>

        <!-- The default group of tests to run as part of the test phase
             You should NOT need to override this property in sub-poms.
             When running tests from the comand line you can specify a group
             e.g. mvn test -Dvcloud.test.groups=Unit to run just the unit tests. -->
        <vcloud.test.groups>Minimum</vcloud.test.groups>
        <vcloud.test.report.dir>${project.build.directory}/surefire-reports</vcloud.test.report.dir>

