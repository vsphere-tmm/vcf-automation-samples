<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>openapi-appliance</artifactId>
  <parent>
    <groupId>com.vmware.vcloud</groupId>
    <artifactId>rest-api-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <packaging>jar</packaging>
  <name>${project.artifactId} - RESTful JAX-RS Stubs for appliance using OpenAPI</name>
  <description>OpenAPI RESTful JAX-RS Stubs for appliance</description>
  <dependencies>
    <!-- vCloud project dependencies (alphabetized) -->
    <dependency>
      <groupId>com.vmware.vcloud</groupId>
      <artifactId>common-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.vmware.vcloud</groupId>
      <artifactId>openapi-jaxrs-stubs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.vmware.vcloud</groupId>
      <artifactId>rest-api-commons</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <!-- https://mvnrepository.com/artifact/javax.validation/validation-api -->
    <dependency>
      <groupId>javax.validation</groupId>
      <artifactId>validation-api</artifactId>
    </dependency>
    <!-- https://mvnrepository.com/artifact/io.swagger/swagger-jaxrs -->
    <dependency>
      <groupId>io.swagger</groupId>
      <artifactId>swagger-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
    </dependency>
  </dependencies>
  <!-- ================================================ -->
  <!-- Module build settings -->
  <!-- ================================================ -->
  <build>
    <pluginManagement>
      <plugins>
        <!-- Set SRCROOT so that we can read specinfo.properties -->
        <plugin>
          <groupId>org.codehaus.gmaven</groupId>
          <artifactId>gmaven-plugin</artifactId>
        </plugin>
        <!-- Inherit the reading of specinfo.properties -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>properties-maven-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>io.swagger</groupId>
          <artifactId>swagger-codegen-maven-plugin</artifactId>
          <version>${openapi.maven.codegen.plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>generate</goal>
              </goals>
              <id>generate-swagger-model-and-apis</id>
              <phase>generate-sources</phase>
              <configuration>
                <language>jaxrs-cxf</language>
                <inputSpec>${project.basedir}/src/main/resources/schemas/appliance-api.yaml</inputSpec>
                <generateModels>true</generateModels>
                <modelPackage>com.vmware.vcloud.appliance.rest.model</modelPackage>
                <generateApis>true</generateApis>
                <apiPackage>com.vmware.vcloud.appliance.rest.api</apiPackage>
                <configOptions>
                  <sourceFolder>src/main/java</sourceFolder>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <artifactVersion>${project.version}</artifactVersion>
                  <artifactUrl>www.vmware.com</artifactUrl>
                  <implFolder>deprecated-impl</implFolder>
                  <dateLibrary>legacy</dateLibrary>
                </configOptions>
                <clearOutputDir>true</clearOutputDir>
                <output>${project.build.directory}/generated-sources</output>
                <staleFile>${project.build.directory}/generated-sources/.staleFlag</staleFile>
                <environmentVariables>
                  <apiTests>false</apiTests>
                </environmentVariables>
              </configuration>
            </execution>
            <execution>
              <goals>
                <goal>generate</goal>
              </goals>
              <id>generate-swagger-models</id>
              <phase>generate-sources</phase>
              <configuration>
                <language>spring</language>
                <inputSpec>${project.basedir}/src/main/resources/schemas/appliance-api.yaml</inputSpec>
                <generateModels>true</generateModels>
                <modelPackage>com.vmware.vcloud.appliance.rest.model</modelPackage>
                <generateApis>false</generateApis>
                <configOptions>
                  <sourceFolder>src/main/java</sourceFolder>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <artifactVersion>${project.version}</artifactVersion>
                  <artifactUrl>www.vmware.com</artifactUrl>
                  <implFolder>deprecated-impl</implFolder>
                  <dateLibrary>legacy</dateLibrary>
                </configOptions>
                <clearOutputDir>true</clearOutputDir>
                <output>${project.build.directory}/generated-sources</output>
                <staleFile>${project.build.directory}/generated-sources/.staleFlag</staleFile>
                <environmentVariables>
                  <apiTests>false</apiTests>
                </environmentVariables>
              </configuration>
            </execution>
            <execution>
              <goals>
                <goal>generate</goal>
              </goals>
              <id>generate-swagger-documentation</id>
              <phase>generate-sources</phase>
              <configuration>
                <inputSpec>${project.basedir}/src/main/resources/schemas/appliance-api.yaml</inputSpec>
                <language>html2</language>
                <configOptions>
                  <sourceFolder>${project.basedir}/src/main/resources/schemas/</sourceFolder>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <artifactVersion>${project.version}</artifactVersion>
                  <artifactUrl>www.vmware.com</artifactUrl>
                  <implFolder>deprecated-impl</implFolder>
                  <invokerPackage>com.vmware.vcloud.rest.openapi</invokerPackage>
                  <dateLibrary>legacy</dateLibrary>
                </configOptions>
                <clearOutputDir>true</clearOutputDir>
                <output>${project.build.directory}/generated-sources/swaggerdoc</output>
                <staleFile>${project.build.directory}/generated-sources/.staleFlag</staleFile>
                <environmentVariables>
                  <apiTests>false</apiTests>
                </environmentVariables>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <executions>
            <execution>
              <phase>process-sources</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <delete includeemptydirs="true" failonerror="false">
                    <fileset dir="${project.basedir}/openapi-specs" includes="**/**"/>
                    <fileset dir="${project.basedir}/target/generated-sources/src/main/java/io" includes="**/**"/>
                    <fileset dir="${project.basedir}/target/generated-sources/deprecated-impl" includes="**/**"/>
                  </delete>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>1.12</version>
          <executions>
            <execution>
              <id>add-builder-sources</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>add-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>${project.build.directory}/generated-sources/src/main/java</source>
                  <source>${project.build.directory}/generated-sources/annotations</source>
                </sources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <excludeResources>true</excludeResources>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <suiteXmlFiles>
              <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
            </suiteXmlFiles>
          </configuration>
        </plugin>
        <!--
                  The OpenAPI code generator outputs some really hard-to-read files, especially when
                  it comes to annotations on fields and methods. This reformats the files into nice,
                  readable, debuggable Java right after they are generated.
              -->
        <plugin>
          <groupId>com.coveo</groupId>
          <artifactId>fmt-maven-plugin</artifactId>
          <configuration>
            <sourceDirectory>${project.build.directory}/generated-sources/src/main/java</sourceDirectory>
            <testSourceDirectory>${project.build.directory}/generated-sources/src/test/java</testSourceDirectory>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>format</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessors>
              <annotationProcessor>com.vmware.vcloud.validation.annotations.processors.OpenApiEntityReferenceMappingCreator</annotationProcessor>
              <annotationProcessor>com.vmware.vcloud.validation.annotations.processors.ConstraintArgValuesValidatorAnnotationProcessor</annotationProcessor>
            </annotationProcessors>
            <annotationProcessorPaths>
              <path>
                <groupId>com.vmware.vcloud</groupId>
                <artifactId>common-validation</artifactId>
                <version>1.0.0</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>1.4</version>
          <executions>
            <execution>
              <id>enforce-banned-dependencies</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <fail>true</fail>
                <failFast>true</failFast>
                <rules>
                  <bannedDependencies>
                    <excludes>
                      <!-- vCloud REST client code should not depend/use product code -->
                      <exclude>com.vmware.vcloud</exclude>
                    </excludes>
                    <includes>
                      <!-- Exceptions to the above exclude for artifacts that aren't really "product code" -->
                      <include>com.vmware.vcloud:rest-api-commons</include>
                      <include>com.vmware.vcloud:openapi-jaxrs-stubs</include>
                      <include>com.vmware.vcloud:common-validation</include>
                    </includes>
                    <message>Product code artifacts should NOT be added as a vCloud REST client dependency!</message>
                  </bannedDependencies>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.gmaven</groupId>
        <artifactId>gmaven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>io.swagger</groupId>
        <artifactId>swagger-codegen-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.coveo</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
